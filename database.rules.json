{
  "rules": {
    "dewdrop": {
      "scores": {
        ".read": true,
        ".indexOn": ["coins", "earned", "harvested"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'coins', 'earned', 'harvested', 'days', 'updated'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "coins": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000000000" },
          "earned": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000000000" },
          "harvested": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "days": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "meadow": { ".validate": "newData.isBoolean()" },
          "updated": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
